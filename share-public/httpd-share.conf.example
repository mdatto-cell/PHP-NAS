# Отдельный порт только для ссылок «Поделиться» (подключить в httpd.conf: Include conf/extra/httpd-share.conf)
# В config.php: 'share' => true, 'share_url' => 'https://files.example.com/share.php'
Listen 8081
<VirtualHost *:8081>
    DocumentRoot "H:/www/share-public"
    <Directory "H:/www/share-public">
        Options -Indexes -FollowSymLinks
        AllowOverride None
        Require all granted
        # отдаём только share.php, всё остальное — 404
        <FilesMatch "^(?!share\.php$)">
            Require all denied
        </FilesMatch>
    </Directory>
    DirectoryIndex disabled
    ErrorLog "logs/share-error.log"
    CustomLog "logs/share-access.log" common
</VirtualHost>

